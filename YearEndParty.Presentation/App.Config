<?xml version="1.0"?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net, Version=1.2.10.0, Culture=neutral, PublicKeyToken=1b44e1d426115821" />
  </configSections>
  <log4net>
    <root>
      <level value="ALL" />
      <appender-ref ref="RollingFile" />
    </root>
    <logger name="UpLogger">
      <level value="DEBUG" />
    </logger>
    <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
      <file value="Logs/log.txt" />
      <appendToFile value="true" />
      <maximumFileSize value="10000KB" />
      <maxSizeRollBackups value="2" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%d [%t] %-5p %c - %m%n" />
      </layout>
    </appender>
  </log4net>
  <appSettings>
    <add key="IP" value="10.19.10.65" />
    <add key="Port" value="51511" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />
    <add key="AdHoc.Top" value="0"/>
    <add key="PrizeList.Top" value="310"/>

    <!-- List prizes screen -->
    <add key="List_TextSize" value="17"/>
    <add key="List_NumberSize" value="33"/>

    <!-- Winner prizes screen -->
    <add key="Detail_NickSize" value="24"/>
    <add key="Detail_NameSize" value="21"/>
    <add key="Detail_DeptSize" value="22"/>
    <add key="Detail_PrizeNumber" value="16"/>

    <!-- Winner prizes super grand screen -->
    <add key="Super_NickSize" value="17"/>
    <add key="Super_NameSize" value="17"/>
    <add key="Super_DeptSize" value="17"/>

    <!-- Adhoc prizes screen -->
    <add key="AdhocList_NickSize" value="13"/>
    <add key="AdhocList_NameSize" value="13"/>
    <add key="AdhocList_DeptSize" value="13"/>
    <add key="Adhoc_NickSize" value="21"/>
    <add key="Adhoc_NameSize" value="18"/>
    <add key="Adhoc_DeptSize" value="22"/>
    <add key="Adhoc_StatusSize" value="28"/>

    <!-- Adhoc sumary winners screen -->
    <add key="listWinner_PrizeNameSize" value="14"/>
    <add key="listWinner_NameSize" value="13"/>
    <add key="listWinner_DeptSize" value="12"/>

    <!-- Allow Super grand duplicate group -->
    <add key="AllowDuplicateGroup" value="true"/>

  </appSettings>
  <connectionStrings>
    <add name="bodb_luckyEntities" connectionString="metadata=res://*/Models.csdl|res://*/Models.ssdl|res://*/Models.msl;provider=System.Data.SqlClient;provider connection string=&quot;data source=10.18.200.231;initial catalog=LuckyDraw2013;persist security info=True;user id=internalteam;password=p@$$w0rd;multipleactiveresultsets=True;App=EntityFramework&quot;" providerName="System.Data.EntityClient" />
