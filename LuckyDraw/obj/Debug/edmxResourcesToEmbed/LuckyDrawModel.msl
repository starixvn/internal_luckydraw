<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="LuckyDrawModelStoreContainer" CdmEntityContainer="LuckyDrawEntities">
    <EntitySetMapping Name="Prizes">
      <EntityTypeMapping TypeName="LuckyDrawModel.Prize">
        <MappingFragment StoreEntitySet="Prizes">
          <ScalarProperty Name="PrizeIndex" ColumnName="PrizeIndex" />
          <ScalarProperty Name="RoundIndex" ColumnName="RoundIndex" />
          <ScalarProperty Name="RoundName" ColumnName="RoundName" />
          <ScalarProperty Name="PrizeName" ColumnName="PrizeName" />
          <ScalarProperty Name="Id" ColumnName="Id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Settings">
      <EntityTypeMapping TypeName="LuckyDrawModel.Setting">
        <MappingFragment StoreEntitySet="Settings">
          <ScalarProperty Name="StartIndex" ColumnName="StartIndex" />
          <ScalarProperty Name="Excluded" ColumnName="Excluded" />
          <ScalarProperty Name="RandomTo" ColumnName="RandomTo" />
          <ScalarProperty Name="RandomFrom" ColumnName="RandomFrom" />
          <ScalarProperty Name="Id" ColumnName="Id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="Results">
      <EntityTypeMapping TypeName="LuckyDrawModel.Result">
        <MappingFragment StoreEntitySet="Results">
          <ScalarProperty Name="PrizeId" ColumnName="PrizeId" />
          <ScalarProperty Name="UpdatedTime" ColumnName="UpdatedTime" />
          <ScalarProperty Name="RoundIndex" ColumnName="RoundIndex" />
          <ScalarProperty Name="PrizeIndex" ColumnName="PrizeIndex" />
          <ScalarProperty Name="RoundName" ColumnName="RoundName" />
          <ScalarProperty Name="PrizeName" ColumnName="PrizeName" />
          <ScalarProperty Name="Flag" ColumnName="Flag" />
          <ScalarProperty Name="Status" ColumnName="Status" />
          <ScalarProperty Name="Random" ColumnName="Random" />
          <ScalarProperty Name="Id" ColumnName="Id" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
  </EntityContainerMapping>
</Mapping>