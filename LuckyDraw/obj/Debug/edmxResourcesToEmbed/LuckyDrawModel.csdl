<?xml version="1.0" encoding="utf-8"?>
<Schema Namespace="LuckyDrawModel" Alias="Self" annotation:UseStrongSpatialTypes="false" xmlns:annotation="http://schemas.microsoft.com/ado/2009/02/edm/annotation" xmlns:customannotation="http://schemas.microsoft.com/ado/2013/11/edm/customannotation" xmlns="http://schemas.microsoft.com/ado/2009/11/edm">
  <EntityContainer Name="LuckyDrawEntities" annotation:LazyLoadingEnabled="true">
    <EntitySet Name="Prizes" EntityType="LuckyDrawModel.Prize" />
    <EntitySet Name="Settings" EntityType="LuckyDrawModel.Setting" />
    <EntitySet Name="Results" EntityType="LuckyDrawModel.Result" />
  </EntityContainer>
  <EntityType Name="Prize">
    <Key>
      <PropertyRef Name="Id" />
    </Key>
    <Property Name="Id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="PrizeName" Type="String" MaxLength="200" FixedLength="false" Unicode="true" />
    <Property Name="RoundName" Type="String" MaxLength="200" FixedLength="false" Unicode="true" />
    <Property Name="RoundIndex" Type="Int32" Nullable="false" />
    <Property Name="PrizeIndex" Type="Int32" Nullable="false" />
  </EntityType>
  <EntityType Name="Setting">
    <Key>
      <PropertyRef Name="Id" />
    </Key>
    <Property Name="Id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="RandomFrom" Type="Int32" Nullable="false" />
    <Property Name="RandomTo" Type="Int32" Nullable="false" />
    <Property Name="Excluded" Type="String" MaxLength="1000" FixedLength="false" Unicode="true" />
    <Property Name="StartIndex" Type="Int32" Nullable="false" />
  </EntityType>
  <EntityType Name="Result">
    <Key>
      <PropertyRef Name="Id" />
    </Key>
    <Property Name="Id" Type="Int32" Nullable="false" annotation:StoreGeneratedPattern="Identity" />
    <Property Name="Random" Type="String" Nullable="false" MaxLength="1000" FixedLength="false" Unicode="true" />
    <Property Name="Status" Type="Int32" Nullable="false" />
    <Property Name="Flag" Type="Int32" Nullable="false" />
    <Property Name="PrizeName" Type="String" MaxLength="200" FixedLength="false" Unicode="true" />
    <Property Name="RoundName" Type="String" MaxLength="200" FixedLength="false" Unicode="true" />
    <Property Name="PrizeIndex" Type="Int32" Nullable="false" />
    <Property Name="RoundIndex" Type="Int32" Nullable="false" />
    <Property Name="UpdatedTime" Type="DateTime" Precision="3" />
    <Property Name="PrizeId" Type="Int32" Nullable="false" />
  </EntityType>
</Schema>