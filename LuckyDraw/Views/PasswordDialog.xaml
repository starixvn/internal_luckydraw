<Window x:Class="LuckyDraw.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LuckyDraw"
        mc:Ignorable="d"
        Title="Password Dialog" Height="152.866" Width="303.822" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Image Source="Resources/question.png" Width="32" Height="32" Grid.RowSpan="2" Margin="20,0" />

        <Label Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top">Enter password:</Label>
        <PasswordBox Name="txtPassword" Grid.Column="1" Grid.Row="1" Width="161" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" ></PasswordBox>

        <WrapPanel Grid.Row="2" Grid.Column="1"  Margin="6,36,0,-21" RenderTransformOrigin="-0.661,0.678">
            <Button IsDefault="True" x:Name="btnDialogOk" Click="BtnOK_Click" MinWidth="60" Margin="0,0,10,0" Content="_Ok"/>
            <Button IsCancel="True" MinWidth="60" Content="_Cancel"/>
        </WrapPanel>
    </Grid>
</Window>
