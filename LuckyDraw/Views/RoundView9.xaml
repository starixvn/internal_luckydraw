<UserControl x:Class="LuckyDraw.Views.RoundView9"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LuckyDraw.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
            >
    <Grid ShowGridLines="False" Margin="15,0,15,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Viewbox Grid.Column="0" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="1" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="2" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="3" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="4" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="5" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="6" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="7" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="8" Grid.Row="0" Height="12" Width="190" ></Viewbox>
        <Viewbox Grid.Column="9" Grid.Row="0" Height="12" Width="190" ></Viewbox>


        <Viewbox Grid.Column="0" Grid.Row="2" Height="10" Grid.ColumnSpan="10"></Viewbox>
        <Viewbox Grid.Column="0" Grid.Row="4" Height="30" Grid.ColumnSpan="10"></Viewbox>

        <StackPanel x:Name="viewBoxItem1" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Top" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem2" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Top"  >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem3"  Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Top">
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem4" Grid.Column="6" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Top" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem5" Grid.Column="8" Grid.ColumnSpan="2" Grid.Row="1" VerticalAlignment="Top"  >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem6" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Top" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem7" Grid.Column="3" Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Top" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem8" Grid.Column="5" Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Top" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem9" Grid.Column="7" Grid.ColumnSpan="2" Grid.Row="3" VerticalAlignment="Top" >
            <local:Item />
        </StackPanel>
    </Grid>
</UserControl>
