<UserControl x:Class="LuckyDraw.RoundView10"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LuckyDraw"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid RenderTransformOrigin="0.502,0.467">       
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>            
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Viewbox Grid.Column="0" Grid.Row="0" Height="30" Grid.ColumnSpan="7"></Viewbox>
        <Viewbox Grid.Column="0" Grid.Row="2" Height="30" Grid.ColumnSpan="7"></Viewbox>
        <Viewbox Grid.Column="0" Grid.Row="4" Height="30" Grid.ColumnSpan="7"></Viewbox>

        <Viewbox x:Name="viewBoxItem1" Grid.Column="0" Grid.Row="1" VerticalAlignment="Top" Margin="5,0,5,0" Height="150">
            <StackPanel>
                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                    <Border.Background>
                        <ImageBrush  x:Name="img1" Stretch="None" />
                    </Border.Background>
                </Border>
                <TextBlock x:Name="textPrize1" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                                           TextWrapping="Wrap"
                                    Width="180" TextAlignment="Center" ></TextBlock>
                <TextBlock x:Name="textRandom1"  Text="000" Foreground="#FFEAAC06" 
                                Width="150" TextAlignment="Center"
                                FontSize="30" FontWeight="Bold"></TextBlock>
                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
            </StackPanel>
        </Viewbox>
        <Viewbox x:Name="viewBoxItem2" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Margin="5,0,5,0" Height="150">
