<UserControl x:Class="LuckyDraw.Views.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LuckyDraw.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <Canvas  x:Name="canvasImage" Opacity="1" Width="86" Height="86">
            <Canvas.Background>
                <ImageBrush ImageSource="../Resources/Images/item-bg.png"/>
            </Canvas.Background>
            <Border Width="81" Height="81" Margin="2,2">
                <Border.Background>
                    <ImageBrush  x:Name="img" Stretch="None" />
                </Border.Background>
            </Border>
        </Canvas>

        <Border Height="35">
            <TextBlock x:Name="textPrize" Text="Prize x" 
                   Foreground="#beb8ff" 
                   FontSize="13" TextWrapping="Wrap"
                   MaxWidth="160"
                   LineStackingStrategy="BlockLineHeight"
                   LineHeight="14"
                   TextAlignment="Center" FontWeight="Bold"
                   Margin="0,6,0,0"                       
                       ></TextBlock>    
        </Border>
        
        <TextBlock x:Name="textRandom"  Text="000" Foreground="#ffd33b" 
                    Width="150" TextAlignment="Center"
                    FontSize="34" FontWeight="Bold"
                   Margin="0,0,0,0"
                   ></TextBlock>
        <Border x:Name="border1" BorderThickness="2 2 0 0" BorderBrush="#ffd33b" Width="7" Height="7" Margin="-50,-60,10,10"/>
        <Border x:Name="border2" BorderThickness="0 2 2 0" BorderBrush="#ffd33b" Width="7" Height="7" Margin="70,-60,10,10"/>
        <Border x:Name="border3" BorderThickness="0 0 2 2" BorderBrush="#ffd33b" Width="7" Height="7" Margin="70,-10,10,7"/>
        <Border x:Name="border4" BorderThickness="2 0 0 2" BorderBrush="#ffd33b" Width="7" Height="7" Margin="-50,-15,10,7"/>
    </StackPanel>
</UserControl>
