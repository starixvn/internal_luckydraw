<Window x:Class="LuckyDraw.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LuckyDraw"
        mc:Ignorable="d"
        Height="150" Width="290" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" 
        Background="Transparent"
        AllowsTransparency="True"
        KeyDown="HandleKeyDown">
    <Border CornerRadius="4" BorderBrush="Gray" Background="White" >
        
    <Grid>        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Width="290" Margin="0,30,0,0">
            <TextBlock x:Name="txtContent" Grid.Row="0" Grid.Column="0" 
               HorizontalAlignment="Center" TextAlignment="Center" Width="220"
                TextWrapping="Wrap" 
               FontSize="15" Foreground="#28257D" FontWeight="Bold"
               >Are you sure?</TextBlock>
        </Border>

        <Border Width="290" Margin="0,60,0,0">
            <WrapPanel Grid.Row="1" Grid.Column="0"  Margin="6,36,0,-21" HorizontalAlignment="Center">
                    <Button IsDefault="True" x:Name="btnYes" Cursor="Hand"
                            Click="BtnOK_Click" MinWidth="60" Margin="0,0,15,0" Content="         Yes"
                            Foreground="White" FontWeight="Bold"
                            Width="90" FontSize="14" Padding="0,2,0,3" 
                            >
                    <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background" Value="#28257D"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3330A1" />
                                    </Trigger>                                    
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                </Button>
                    <Button x:Name="btnNo" IsCancel="True" MinWidth="60" Content="        No" FontWeight="Bold" Cursor="Hand"
                        Width="90" FontSize="14" Padding="0,2,0,2" >
                        <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" 
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}"
                                                        >
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>                                            
                                        </Setter.Value>
                                    </Setter>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#28257D"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#28257D"/> 
                                <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3330A1" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                    </Style.Triggers>
                                </Style>
                        </Button.Style>
                </Button>
            </WrapPanel>
        </Border>
    </Grid>
    </Border>
</Window>
