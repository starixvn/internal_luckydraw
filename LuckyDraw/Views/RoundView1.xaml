<UserControl x:Class="LuckyDraw.Views.RoundView1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LuckyDraw.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid ShowGridLines="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="5*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"></RowDefinition>
            <RowDefinition Height="50*"></RowDefinition>
            <RowDefinition Height="25*"></RowDefinition>
        </Grid.RowDefinitions>

        <Viewbox Grid.Column="0" Grid.Row="0" Height="150" Grid.ColumnSpan="7"></Viewbox>        
        
        <Viewbox x:Name="viewBoxItem1" Grid.Column="3" Grid.Row="1" Margin="5,0,5,0">
            <StackPanel Grid.Column="3" Grid.Row="1">
                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                    <Border.Background>
                        <ImageBrush  x:Name="img1" Stretch="None" />
                    </Border.Background>
                </Border>
                <TextBlock x:Name="textPrize1" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                                           TextWrapping="Wrap"
                                    Width="180" MaxHeight="55" TextAlignment="Center" ></TextBlock>
                <TextBlock x:Name="textRandom1"  Text="000" Foreground="#FFEAAC06" 
                                Width="150" TextAlignment="Center"
                                FontSize="30" FontWeight="Bold"></TextBlock>
                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
            </StackPanel>
        </Viewbox>
        
        <Viewbox Grid.Column="0" Grid.Row="2" Height="150" Grid.ColumnSpan="7"></Viewbox>
        
        
    </Grid>
</UserControl>
