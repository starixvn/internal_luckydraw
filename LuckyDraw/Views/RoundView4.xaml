<UserControl x:Class="LuckyDraw.Views.RoundView4"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LuckyDraw.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid ShowGridLines="False" Margin="20,0,20,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
            <ColumnDefinition Width="16*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="25*"></RowDefinition>
            <RowDefinition Height="50*"></RowDefinition>
            <RowDefinition Height="25*"></RowDefinition>
        </Grid.RowDefinitions>
       
        
        <Viewbox Grid.Column="0" Grid.Row="0" Height="70" Grid.ColumnSpan="7"></Viewbox>
        <Viewbox Grid.Column="0" Grid.Row="2" Height="70" Grid.ColumnSpan="7"></Viewbox>

        <StackPanel x:Name="viewBoxItem1" Grid.Column="0" Grid.Row="1" VerticalAlignment="Top" Margin="5,0,5,0" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem2" Grid.Column="1" Grid.Row="1" VerticalAlignment="Top" Margin="25,0,5,0" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem3"  Grid.Column="2" Grid.Row="1" VerticalAlignment="Top" Margin="25,0,5,0" >
            <local:Item />
        </StackPanel>
        <StackPanel x:Name="viewBoxItem4"  Grid.Column="3" Grid.Row="1" VerticalAlignment="Top" Margin="25,0,5,0" >
            <local:Item />
        </StackPanel>
    </Grid>
</UserControl>
