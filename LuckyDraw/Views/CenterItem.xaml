<Window x:Class="LuckyDraw.Views.CenterItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LuckyDraw.Views"
        mc:Ignorable="d"
        Title="CenterItem" Background="Transparent" WindowStyle="None" AllowsTransparency="True">
    <Border BorderBrush="#FF2D3D5F" BorderThickness="2" >
        <Grid >            
            <Grid.Background>
                <ImageBrush ImageSource="../Resources/Images/bg.jpg"/>
            </Grid.Background>
            <Viewbox >
                <StackPanel x:Name="viewBoxItemCenter" Grid.Column="3" Grid.Row="1" Margin="5,0,5,0" >
                    <local:Item x:Name="centerItem"/>
                </StackPanel>
            </Viewbox>
        </Grid>
    </Border>
</Window>
