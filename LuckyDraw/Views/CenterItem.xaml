<Window x:Class="LuckyDraw.Views.CenterItem"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LuckyDraw.Views"
        Width="898"
        Height="1080"
        mc:Ignorable="d"
        Title="CenterItem" Background="Transparent" WindowStyle="None" AllowsTransparency="True">
        <Grid >            
            <Grid.Background>
                <ImageBrush ImageSource="../Resources/Images/bg-item.png"/>
            </Grid.Background>
            <Border Margin="100,90,100,120">
            <Viewbox >
                <StackPanel x:Name="viewBoxItemCenter" Grid.Column="3" Grid.Row="1" Margin="0,0,0,0">
                    <local:Item x:Name="centerItem"/>
                </StackPanel>
            </Viewbox>
        </Border>
    </Grid>
</Window>
