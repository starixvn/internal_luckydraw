<Window x:Class="LuckyDraw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lucky Draw" Height="743.15" Width="1222.45" WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Home" Click="HomeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/home.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Settings" Click="SettingMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/setting.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Result" Click="ResultMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/results.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Log" Click="LogMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/log.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Minimize" Click="MinimizeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/minimize.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Exit" Click="ExitMenu_Click" >
                <MenuItem.Icon >
                    <Image Source="Resources/Images/exit.ico" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>
    <TabControl x:Name="mainTab" Grid.ColumnSpan="2" BorderBrush="{x:Null}" SelectionChanged="TabControl_SelectionChanged">
        <TabItem x:Name="tabHome" Header="Home" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid Margin="50,-2,74,-1">
                <Label x:Name="textRound" Content="Round" HorizontalAlignment="Left" Margin="110,20,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.27,0.293" Foreground="#FF977070" FontSize="24" BorderThickness="8,0,0,0" FontWeight="Bold"/>
                <Canvas x:Name="canvasItem1" HorizontalAlignment="Left" Height="71" Margin="132,85,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize1" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img1" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom1" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Button Content="Run" HorizontalAlignment="Left" Margin="125,468,0,0" VerticalAlignment="Top" Width="74"
                        Click="RunButton_Click"/>
                <Button Content="Previous" HorizontalAlignment="Left" Margin="232,468,0,0" VerticalAlignment="Top" Width="75" RenderTransformOrigin="0.155,0.944"
                        Click="PreviousButton_Click"/>
                <Button Content="Next" HorizontalAlignment="Left" Margin="336,468,0,0" VerticalAlignment="Top" Width="74" RenderTransformOrigin="1.293,1.038"
                        Click="NextButton_Click"/>
                <Label x:Name="textRandomRange" Content="Range" HorizontalAlignment="Left"  VerticalAlignment="Top" Foreground="#FF7C6A6A" FontSize="18" BorderThickness="8,0,0,0" Margin="110,531,0,0" />
                <Label x:Name="textIgnored" Content="Ignored" HorizontalAlignment="Left"  VerticalAlignment="Top" Foreground="#FF7C6A6A" FontSize="18" BorderThickness="8,0,0,0" Margin="110,560,0,0"/>
                <Canvas x:Name="canvasItem2" HorizontalAlignment="Left" Height="70" Margin="534,86,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize2" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img2" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom2" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem3" HorizontalAlignment="Left" Height="70" Margin="132,162,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize3" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img3" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom3" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem4" HorizontalAlignment="Left" Height="70" Margin="534,162,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize4" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img4" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom4" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem5" HorizontalAlignment="Left" Height="72" Margin="132,232,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize5" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img5" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom5" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem6" HorizontalAlignment="Left" Height="72" Margin="534,232,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize6" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img6" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom6" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem7" HorizontalAlignment="Left" Height="70" Margin="136,304,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize7" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img7" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom7" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem8" HorizontalAlignment="Left" Height="70" Margin="534,304,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize8" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img8" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom8" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem9" HorizontalAlignment="Left" Height="72" Margin="136,374,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize9" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img9" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom9" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
                <Canvas x:Name="canvasItem10" HorizontalAlignment="Left" Height="72" Margin="534,374,0,0" VerticalAlignment="Top" Width="398">
                    <Label x:Name="textPrize10" Content="Prize" RenderTransformOrigin="-0.153,0.304" Foreground="#FF5A68C3" FontSize="20" Canvas.Top="23" Canvas.Left="65"/>
                    <Image x:Name="img10" Width="50" Height="50" Canvas.Left="10" Canvas.Top="10" />
                    <Label x:Name="textRandom10" Content="000" Canvas.Left="185" Canvas.Top="23" RenderTransformOrigin="-0.054,-0.948" Foreground="#FF9B3D33" FontSize="20"/>
                </Canvas>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabSetting" Header="Settings" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Settings" Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,0,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <TabControl Grid.ColumnSpan="2" Margin="33,50,30,30" >
                    <TabItem x:Name="tabPrize" Header="Prizes">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="prizeDataGrid" Margin="33.418,10,302,75" CanUserAddRows ="True" Grid.Column="1" 
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PrizeIndex" Binding="{Binding PrizeIndex}"/>
                                    <DataGridTextColumn Header="PrizeName" Binding="{Binding PrizeName}" />
                                    <DataGridTextColumn Header="RoundIndex" Binding="{Binding RoundIndex}"/>
                                    <DataGridTextColumn Header="RoundName" Binding="{Binding RoundName}" />
                                    <DataGridTemplateColumn Header="Image" Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding TaskImg}" Stretch="None" Width="50" Height="50" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn  Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Upload Image" Width="85"
                                                    Click="UploadButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SavePrizesButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRange" Header="Random Range">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="rangeDataGrid" Margin="33.418,10,302,75" Grid.Column="1"
                                      AutoGenerateColumns="False" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Random From" Binding="{Binding RandomFrom}"/>
                                    <DataGridTextColumn Header="Random To" Binding="{Binding RandomTo}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SaveRangeButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabIgnoredList" Header="Ignored List">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="ignoredListDataGrid" AutoGenerateColumns="False" Margin="33.418,10,302,75" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ignored List" Binding="{Binding Excluded}" Width="500"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75"
                                Click="SaveIgnoredListButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRun" Header="Run" >
                        <Grid Margin="10,-2,74,-1">
                            <Button Content="Start New Game" Height="28" Width="100" Margin="70,125,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                    Click="NewGameButton_Click" />
                            <Label Content="Start Prize Index" HorizontalAlignment="Left" Margin="70,75,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.395,1.154"/>
                            <TextBox x:Name="textPrizeStartIndex" HorizontalAlignment="Left" Height="23" Margin="170,79,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.554,0.913"/>
                            <TextBlock HorizontalAlignment="Left" Margin="315,70,0,0" TextWrapping="Wrap" Text="You should always keep this value 1 unless you really need to start at a specific prize index. All prizes less than this start index will be ignored." VerticalAlignment="Top" Height="39" Width="482" Foreground="#FFDA0707"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabResult" Header="Result" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Result" Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="resultDataGrid" Margin="33.418,60,30,30" IsReadOnly="True" Grid.Column="1"
                            SelectionChanged="ResultDataGrid_SelectionChanged"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabLog" Header="Log" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Log" Canvas.Left="185" Canvas.Top="23" FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="logDataGrid" Margin="33,60,30,30" IsReadOnly="True"
                          SelectionChanged="LogDataGrid_SelectionChanged"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>