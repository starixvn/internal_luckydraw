<Window x:Class="LuckyDraw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:luckydraw="clr-namespace:LuckyDraw"
        xmlns:luckydraw1="clr-namespace:LuckyDraw.Views"
        mc:Ignorable="d"        
        Title="Lucky Draw" Height="743.15" Width="1222.45" WindowStartupLocation="CenterOwner" 
        Padding="0" Background="#FF080808" WindowState="Maximized" WindowStyle="None"
        KeyDown="HandleKeyDown">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Home" Click="HomeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/home.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Settings" Click="SettingMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/setting.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Result" Click="ResultMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/results.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Log" Click="LogMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/log.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Minimize" Click="MinimizeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/minimize.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Exit" Click="ExitMenu_Click" >
                <MenuItem.Icon >
                    <Image Source="Resources/Images/exit.ico" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="TransparentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="mainTab" Grid.ColumnSpan="2" BorderBrush="{x:Null}" SelectionChanged="TabControl_SelectionChanged" Padding="0" >
        <TabItem x:Name="tabHome" Header="Home" BorderBrush="{x:Null}" Margin="0" Padding="0" Visibility="Collapsed" >
            <Grid Background="Black">
                <Viewbox>
                    <Grid Width="1024" Height="768" ShowGridLines="False">
                        <Grid.Background>
                            <ImageBrush ImageSource="Resources/Images/bg.png"/>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0*"></RowDefinition>
                            <RowDefinition Height="64*"></RowDefinition>
                            <RowDefinition Height="370*"></RowDefinition>
                            <RowDefinition Height="125*"></RowDefinition>
                            <RowDefinition Height="49*"></RowDefinition>
                            <RowDefinition Height="138*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Viewbox Grid.Column="1" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,20,0,-5" Grid.ColumnSpan="5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                <Rectangle Width="49" Height="100" Margin="0,0,0,0">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="Resources/Images/left.png" />
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Border Height="100">
                                    <Border.Background>
                                        <ImageBrush ImageSource="Resources/Images/center.png"/>
                                    </Border.Background>                                    
                                    <TextBlock x:Name="textRound" TextWrapping="Wrap" Text="ROUND long long long" 
                                            Foreground="#FFEAAC06" FontSize="36" FontWeight="Bold" 
                                               FontFamily="Resources/Fonts/nulshock.ttf #Nulshock Rg"
                                            Padding="0,0,0,5" VerticalAlignment="Center">                                        
                                    </TextBlock>
                                </Border>
                                
                                <Rectangle Width="49" Height="100" Margin="0,0,0,0">
                                    <Rectangle.Fill>
                                        <ImageBrush ImageSource="Resources/Images/right.png" />
                                    </Rectangle.Fill>
                                </Rectangle>
                            </StackPanel>
                        </Viewbox>

                        <Viewbox x:Name="roundViewBox" Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="7" >                            
                            <luckydraw1:RoundView10 x:Name="roundView10" />
                        </Viewbox>

                        <Viewbox Grid.Column="2" Grid.Row="3" Width="65" HorizontalAlignment="Right" Margin="0,-25,5,0">
                            <Button Style="{StaticResource TransparentButton}" Click="PreviousButton_Click" Focusable="False" >
                                <StackPanel Cursor="Hand">
                                    <TextBlock TextAlignment="Right" Margin="10,0,-5,-11" FontWeight="Bold" Text="PREVIOUS">                                        
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#aa8dc5"/>
                                                 <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel,AncestorLevel=1}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFEAAC06" />
                                                     </DataTrigger>
                                                 </Style.Triggers>
                                             </Style>
                                          </TextBlock.Style>
                                    </TextBlock>
                                    <Image Width="60" Height="22" >
                                        <Image.Style>
                                            <Style TargetType="{x:Type Image}">
                                                <Setter Property="Source" Value="Resources/Images/prev.png"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel,AncestorLevel=1}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Source" Value="Resources/Images/prev-hover.png"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </StackPanel>
                            </Button>
                        </Viewbox>
                        <Viewbox Grid.Column="3" Grid.Row="3" >
                            <StackPanel>
                                <Button Width="144" Height="100" Style="{StaticResource TransparentButton}"
                                    Click="RunButton_Click" BorderBrush="{x:Null}" Background="{x:Null}" Focusable="False" >
                                    <StackPanel Cursor="Hand">
                                        <Image Width="144" Height="100" >
                                            <Image.Style>
                                                <Style TargetType="{x:Type Image}">
                                                    <Setter Property="Source" Value="Resources/Images/run.png"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel,AncestorLevel=2}, Path=IsMouseOver}" Value="True">
                                                            <Setter Property="Source" Value="Resources/Images/run-hover.png"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </StackPanel>
                                </Button>
                                <Image Width="50" Height="80"  Margin="0,-50,0,0">
                                        <Image.Style>
                                            <Style TargetType="{x:Type Image}">
                                                <Setter Property="Source" Value="Resources/Images/arrow.png"/>
                                                <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel,AncestorLevel=1}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Source" Value="Resources/Images/arrow-hover.png"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                </Image>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox Grid.Column="4" Grid.Row="3" Width="34" HorizontalAlignment="Left" Margin="0,-25,0,0">
                            <Button Style="{StaticResource TransparentButton}" Click="NextButton_Click" Focusable="False">
                                <StackPanel Cursor="Hand">
                                    <TextBlock Margin="-5,0,0,-10" FontWeight="Bold" Text="NEXT">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Foreground" Value="#aa8dc5"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel,AncestorLevel=1}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFEAAC06" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Width="32" Height="20">
                                        <Image.Style>
                                            <Style TargetType="{x:Type Image}">
                                                <Setter Property="Source" Value="Resources/Images/next.png"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=StackPanel,AncestorLevel=1}, Path=IsMouseOver}" Value="True">
                                                        <Setter Property="Source" Value="Resources/Images/next-hover.png"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </StackPanel>
                            </Button>
                        </Viewbox>

                        <Viewbox Grid.Row="4" Grid.Column="3" VerticalAlignment="Top" Height="57" Margin="11,-20,12,0">
                            <StackPanel>
                                <TextBlock Text="RANGE RANDOM" Foreground="#aa8dc5" 
                                           FontWeight="Bold"
                                            FontSize="12"                                   
                                            TextAlignment="Center" 
                                           Padding="5,0,5,0"/>
                                <TextBlock x:Name="textRandomRange" 
                                           Margin="0,-2,0,0"
                                    TextWrapping="Wrap" Text="100-200"                                 
                                    TextDecorations="{x:Null}" 
                                    TextAlignment="Center"
                                    Foreground="#FFEAAC06" FontSize="15"
                                    Padding="25,0,25,0"
                                    FontWeight="Bold"
                               />
                            </StackPanel>
                        </Viewbox>

                        <Border Grid.Column="2" Grid.Row="5" Grid.ColumnSpan="3" Margin="60,0,60,0">
                            <StackPanel VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <TextBlock Text=" IGNORED " VerticalAlignment="Center" Foreground="#aa8dc5" 
                                               FontWeight="Bold" FontSize="15" 
                                               HorizontalAlignment="Center" Margin="0,0,0,5"
                                           />
                                <Border BorderBrush="#2c2764" BorderThickness="1" Opacity="1" Margin="0,-3,0,0" HorizontalAlignment="Center">
                                    <TextBlock x:Name="textIgnored" 
                                            Margin="0,0,0,0"
                                            Padding="5"      
                                            TextWrapping="Wrap" 
                                            MinWidth="150"
                                            TextAlignment="Center"                                                 
                                            HorizontalAlignment="Center"
                                            Text="100 - 200 - 300 - 200 - 300 - 200 - 300 - 200 - 300 - 200 - 300 - 200 - 300 - 200 - 300 - 200 - 300 - 200 - 300"                                
                                            TextDecorations="{x:Null}" 
                                            Foreground="#6f6a9d" FontSize="15" Opacity="1">
                                        <TextBlock.Background>
                                            <SolidColorBrush Color="#1a1740" Opacity="0.2" />
                                        </TextBlock.Background>
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Viewbox>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabSetting" Header="Settings" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,0,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <TabControl Grid.ColumnSpan="2" Margin="33,50,30,30" >
                    <TabItem x:Name="tabPrize" Header="Prizes">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="prizeDataGrid" Margin="33.418,10,302,75" CanUserAddRows ="True" Grid.Column="1" 
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PrizeIndex" Binding="{Binding PrizeIndex}"/>
                                    <DataGridTextColumn Header="PrizeName" Binding="{Binding PrizeName}" />
                                    <DataGridTextColumn Header="RoundIndex" Binding="{Binding RoundIndex}"/>
                                    <DataGridTextColumn Header="RoundName" Binding="{Binding RoundName}" />
                                    <DataGridTemplateColumn Header="Image" Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding PrizeImage}" Stretch="None" Width="50" Height="50" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn  Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Upload Image" Width="85"
                                                    Click="UploadButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SavePrizesButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRange" Header="Random Range">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="rangeDataGrid" Margin="33.418,10,302,75" Grid.Column="1"
                                      AutoGenerateColumns="False" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Random From" Binding="{Binding RandomFrom}"/>
                                    <DataGridTextColumn Header="Random To" Binding="{Binding RandomTo}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SaveRangeButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRandomTime" Header="Random Time">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="randomTimeDataGrid" Margin="33.418,10,302,75" Grid.Column="1"
                                      AutoGenerateColumns="False" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Random Animation Duration" Binding="{Binding RandomAnimationDuration}"/>
                                    <DataGridTextColumn Header="Random Transition Duration" Binding="{Binding RandomTransitionDuration}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SaveRandomTimeButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabIgnoredList" Header="Ignored List">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="ignoredListDataGrid" AutoGenerateColumns="False" Margin="33.418,10,302,75" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ignored List" Binding="{Binding Excluded}" Width="500"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75"
                                Click="SaveIgnoredListButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRun" Header="New Game" >
                        <Grid Margin="10,-2,74,-1">
                            <Button Content="Start New Game" Height="28" Width="100" Margin="62,48,0,0" 
                                    HorizontalAlignment="Left" VerticalAlignment="Top" 
                                    Click="NewGameButton_Click" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRunningIndex" Header="Running Index" >
                        <Grid Margin="10,-2,74,-1">
                            <Label Content="Running Index" HorizontalAlignment="Left" Margin="70,52,0,0" VerticalAlignment="Top"/>
                            <TextBox x:Name="textRunningIndex" Height="23" TextWrapping="Wrap" Width="120" Margin="183,52,756,531"
                                     HorizontalAlignment="Left" VerticalAlignment="Top"/>
                            <Button Content="Update" Height="22" Width="77" Margin="183,104,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                    Click="UpdateRunningIndexButton_Click" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabResetRandom" Header="Reset Randoms" >
                        <Grid Margin="10,-2,74,-1">
                            <Label Content="Reset Randoms At Index" Margin="52,35,851,542" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <TextBox x:Name="textResetRandoms" Height="23" TextWrapping="Wrap" Margin="213,35,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="205" />
                            <Button Content="Update" Height="24" Width="80" Margin="213,76,0,0" 
                                    Click="ResetRandomButton_Click" RenderTransformOrigin="1.46,-0.857" 
                                    HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabResult" Header="Result" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Result" Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="resultDataGrid" Margin="33.418,60,30,100" IsReadOnly="True" Grid.Column="1"
                            SelectionChanged="ResultDataGrid_SelectionChanged"/>
                <Button Content="Export" Click="ExportResultButton_Click" Width="100" Height="50" 
                        Cursor="Hand" FontSize="18" FontWeight="Bold"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="33,0,0,20"></Button>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabLog" Header="Log" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Log" Canvas.Left="185" Canvas.Top="23" FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="logDataGrid" Margin="33,60,30,30" IsReadOnly="True"
                          SelectionChanged="LogDataGrid_SelectionChanged"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>