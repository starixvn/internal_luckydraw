<Window x:Class="LuckyDraw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lucky Draw" Height="743.15" Width="1222.45" WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None" Padding="0" Background="#FF080808">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Home" Click="HomeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/home.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Settings" Click="SettingMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/setting.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Result" Click="ResultMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/results.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Log" Click="LogMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/log.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Minimize" Click="MinimizeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/minimize.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Exit" Click="ExitMenu_Click" >
                <MenuItem.Icon >
                    <Image Source="Resources/Images/exit.ico" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="TransparentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="mainTab" Grid.ColumnSpan="2" BorderBrush="{x:Null}" SelectionChanged="TabControl_SelectionChanged" Padding="0" >
        <TabItem x:Name="tabHome" Header="Home" BorderBrush="{x:Null}" Margin="0" Padding="0">
            <Grid RenderTransformOrigin="0.502,0.467"  ShowGridLines="True" >
                <Grid.Background>
                    <ImageBrush ImageSource="Resources/Images/background.jpg"/>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="7*"></RowDefinition>
                    <RowDefinition Height="57*"></RowDefinition>
                    <RowDefinition Height="167*"></RowDefinition>
                    <RowDefinition Height="172*"></RowDefinition>
                    <RowDefinition Height="125*"></RowDefinition>
                    <RowDefinition Height="69*"></RowDefinition>
                    <RowDefinition Height="69*"></RowDefinition>
                    <RowDefinition Height="49*"></RowDefinition>
                </Grid.RowDefinitions>

                <Canvas Grid.Column="3" MinHeight="100"  Grid.Row="1" MinWidth="100" Margin="0,0,0,95" Grid.RowSpan="2">
                    <TextBlock x:Name="textRound" MinHeight="17" Canvas.Left="24" TextWrapping="Wrap" Text="ROUND" MinWidth="92" RenderTransformOrigin="0.571,-2.265" 
                               HorizontalAlignment="Center" TextDecorations="Underline" 
                               Foreground="#FFEAAC06" FontSize="36"/>
                </Canvas>

                <Canvas x:Name="canvasItem1" HorizontalAlignment="Left" Height="94"  VerticalAlignment="Top" Width="163" Grid.Column="1" Grid.Row="2">
                    <Image x:Name="img1" Width="100" Height="100" Canvas.Left="87" Canvas.Top="2" 
                           RenderTransformOrigin="2.1,0.48" />
                    <TextBlock x:Name="textPrize1" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom1" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem2" HorizontalAlignment="Left" Height="94" VerticalAlignment="Top" Width="163" Grid.Column="2" Grid.Row="2">
                    <Image x:Name="img2" Width="100" Height="100" Canvas.Left="91" Canvas.Top="2" />
                    <TextBlock x:Name="textPrize2" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom2" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem3" HorizontalAlignment="Left" Height="99" VerticalAlignment="Top" Width="161" Grid.Column="3" Grid.Row="2">
                    <Image x:Name="img3" Width="100" Height="100" Canvas.Left="86" Canvas.Top="2" RenderTransformOrigin="2.14,0.39" />
                    <TextBlock x:Name="textPrize3" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom3" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem4" HorizontalAlignment="Left" Height="94" VerticalAlignment="Top" Width="163" Grid.Column="4" Grid.Row="2">
                    <Image x:Name="img4" Width="100" Height="100" Canvas.Left="80" />
                    <TextBlock x:Name="textPrize4" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom4" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem5" HorizontalAlignment="Left" Height="94" VerticalAlignment="Top" Width="164" Grid.Column="5" Grid.Row="2">
                    <Image x:Name="img5" Width="100" Height="100" Canvas.Left="84" />
                    <TextBlock x:Name="textPrize5" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom5" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem6" HorizontalAlignment="Left" Height="71" VerticalAlignment="Top" Width="163" Grid.Column="1" Grid.Row="3">
                    <Image x:Name="img6" Width="100" Height="100" Canvas.Left="88" Canvas.Top="1" />
                    <TextBlock x:Name="textPrize6" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom6" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem7" HorizontalAlignment="Left" Height="71" VerticalAlignment="Top" Width="156" Grid.Column="2" Grid.Row="3">
                    <Image x:Name="img7" Width="100" Height="100" Canvas.Left="86" />
                    <TextBlock x:Name="textPrize7" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom7" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem8" HorizontalAlignment="Left" Height="71" VerticalAlignment="Top" Width="168" Grid.Column="3" Grid.Row="3">
                    <Image x:Name="img8" Width="100" Height="100" Canvas.Left="92" RenderTransformOrigin="2.29,0.54" />
                    <TextBlock x:Name="textPrize8" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom8" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem9" HorizontalAlignment="Left" Height="71" VerticalAlignment="Top" Width="163" Grid.Column="4" Grid.Row="3">
                    <Image x:Name="img9" Width="100" Height="100" Canvas.Left="90" />
                    <TextBlock x:Name="textPrize9" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom9" TextDecorations="Underline" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="22" Canvas.Left="87" Canvas.Top="130" FontWeight="Bold"></TextBlock>
                </Canvas>
                <Canvas x:Name="canvasItem10" HorizontalAlignment="Left" Height="71" VerticalAlignment="Top" Width="164" Grid.Column="5" Grid.Row="3">
                    <Image x:Name="img10" Width="100" Height="100" Canvas.Left="88" />
                    <TextBlock x:Name="textPrize10" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="100" TextAlignment="Center"
                               Canvas.Top="105" Canvas.Left="87"  ></TextBlock>
                    <TextBlock x:Name="textRandom10" Text="000" Foreground="#FFEAAC06" FontSize="22" 
                               Width="100" TextAlignment="Center"
                               Canvas.Left="87" Canvas.Top="130" TextDecorations="Underline" FontWeight="Bold"></TextBlock>
                </Canvas>

                <Canvas Grid.Column="2" Grid.Row="4" HorizontalAlignment="Right" Margin="0,35,80,0" Width="0">
                    <Button Style="{StaticResource TransparentButton}" Click="PreviousButton_Click" >
                        <StackPanel Cursor="Hand">
                            <TextBlock Foreground="#FFD8D8D6" TextAlignment="Right" Margin="0,0,0,-10">PREVIOUS</TextBlock>
                            <Image Width="70" Height="20" Source="Resources/Images/prev.png"></Image>
                        </StackPanel>
                    </Button>
                </Canvas>
                <Canvas Grid.Column="3" Grid.Row="4"  >
                    <Button Width="144" Height="100" Style="{StaticResource TransparentButton}"
                            HorizontalContentAlignment="Center" 
                        Click="RunButton_Click" Grid.Column="3" Grid.Row="4" BorderBrush="{x:Null}" Background="{x:Null}">
                        <StackPanel Cursor="Hand">
                            <Image Width="144" Height="100" Source="Resources/Images/run.png"></Image>
                        </StackPanel>
                    </Button>
                    <Image Width="100" Height="100" Canvas.Top="60" Canvas.Left="25" Source="Resources/Images/arrow.png"
                           HorizontalAlignment="Center"
                           ></Image>
                </Canvas>
                <Canvas Grid.Column="4" Grid.Row="4" HorizontalAlignment="Left" Margin="10,35,0,0" Width="0" >
                    <Button Style="{StaticResource TransparentButton}" Click="NextButton_Click" >
                        <StackPanel Cursor="Hand">
                            <TextBlock Foreground="#FFEAAC06" Margin="0,0,0,-10">NEXT</TextBlock>
                            <Image Width="40" Height="20" Source="Resources/Images/next.png"></Image>
                        </StackPanel>
                    </Button>
                </Canvas>


                <Canvas Grid.Column="2" MinHeight="100"  Grid.Row="5" Grid.ColumnSpan="3"  >
                    <TextBlock Text="RANGE RANDOM" Foreground="#FFD8D8D6" 
                            Canvas.Top="10" FontSize="20"
                               Width="430"
                               TextAlignment="Center"/>
                    <TextBlock x:Name="textRandomRange" MinHeight="17" 
                               Width="430"
                               TextWrapping="Wrap" Text="100-200" 
                                Canvas.Top="46"                                
                               TextDecorations="{x:Null}" 
                               TextAlignment="Center"
                               Foreground="#FFEAAC06" FontSize="24"
                               />
                </Canvas>
                <Canvas x:Name="canvasIgnored" MinHeight="100" HorizontalAlignment="Center"
                        Grid.ColumnSpan="3" Grid.Column="2" Grid.Row="6" >
                    <Label Content="----------------------------IGNORED---------------------------" Foreground="#FFD8D8D6"                            
                           Canvas.Top="10" FontSize="16"/>
                    <TextBlock x:Name="textIgnored" MinHeight="17" TextWrapping="Wrap"
                               Width="430"
                           Text="100,200,100,200,100,200,100,200,100,200,100,200,100,200,100,200," 
                               Canvas.Top="40" 
                              TextDecorations="{x:Null}" 
                               Foreground="#FFEAAC06" FontSize="16"/>
                </Canvas>

            </Grid>
        </TabItem>
        <TabItem x:Name="tabSetting" Header="Settings" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Settings" Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,0,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <TabControl Grid.ColumnSpan="2" Margin="33,50,30,30" >
                    <TabItem x:Name="tabPrize" Header="Prizes">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="prizeDataGrid" Margin="33.418,10,302,75" CanUserAddRows ="True" Grid.Column="1" 
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PrizeIndex" Binding="{Binding PrizeIndex}"/>
                                    <DataGridTextColumn Header="PrizeName" Binding="{Binding PrizeName}" />
                                    <DataGridTextColumn Header="RoundIndex" Binding="{Binding RoundIndex}"/>
                                    <DataGridTextColumn Header="RoundName" Binding="{Binding RoundName}" />
                                    <DataGridTemplateColumn Header="Image" Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding PrizeImage}" Stretch="None" Width="50" Height="50" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn  Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Upload Image" Width="85"
                                                    Click="UploadButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SavePrizesButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRange" Header="Random Range">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="rangeDataGrid" Margin="33.418,10,302,75" Grid.Column="1"
                                      AutoGenerateColumns="False" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Random From" Binding="{Binding RandomFrom}"/>
                                    <DataGridTextColumn Header="Random To" Binding="{Binding RandomTo}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SaveRangeButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabIgnoredList" Header="Ignored List">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="ignoredListDataGrid" AutoGenerateColumns="False" Margin="33.418,10,302,75" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ignored List" Binding="{Binding Excluded}" Width="500"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75"
                                Click="SaveIgnoredListButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRun" Header="Run" >
                        <Grid Margin="10,-2,74,-1">
                            <Button Content="Start New Game" Height="28" Width="100" Margin="70,125,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                    Click="NewGameButton_Click" />
                            <Label Content="Start Prize Index" HorizontalAlignment="Left" Margin="70,75,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.395,1.154"/>
                            <TextBox x:Name="textPrizeStartIndex" HorizontalAlignment="Left" Height="23" Margin="170,79,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.554,0.913"/>
                            <TextBlock HorizontalAlignment="Left" Margin="315,70,0,0" TextWrapping="Wrap" Text="You should always keep this value 1 unless you really need to start at a specific prize index. All prizes less than this start index will be ignored." VerticalAlignment="Top" Height="39" Width="482" Foreground="#FFDA0707"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabResult" Header="Result" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Result" Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="resultDataGrid" Margin="33.418,60,30,30" IsReadOnly="True" Grid.Column="1"
                            SelectionChanged="ResultDataGrid_SelectionChanged"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabLog" Header="Log" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Log" Canvas.Left="185" Canvas.Top="23" FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="logDataGrid" Margin="33,60,30,30" IsReadOnly="True"
                          SelectionChanged="LogDataGrid_SelectionChanged"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>