<Window x:Class="LuckyDraw.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Lucky Draw" Height="743.15" Width="1222.45" WindowStartupLocation="CenterScreen" WindowState="Maximized" WindowStyle="None" Padding="0" Background="#FF080808">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Home" Click="HomeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/home.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Settings" Click="SettingMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/setting.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Result" Click="ResultMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/results.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Log" Click="LogMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/log.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="Minimize" Click="MinimizeMenu_Click">
                <MenuItem.Icon >
                    <Image Source="Resources/Images/minimize.ico" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <MenuItem Header="Exit" Click="ExitMenu_Click" >
                <MenuItem.Icon >
                    <Image Source="Resources/Images/exit.ico" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.Resources>
        <Style x:Key="TransparentButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <TabControl x:Name="mainTab" Grid.ColumnSpan="2" BorderBrush="{x:Null}" SelectionChanged="TabControl_SelectionChanged" Padding="0" >
        <TabItem x:Name="tabHome" Header="Home" BorderBrush="{x:Null}" Margin="0" Padding="0" Visibility="Collapsed" >
            <Grid Background="Black">
                <Viewbox>
                    <Grid RenderTransformOrigin="0.502,0.467"   Width="768" Height="768">
                        <Grid.Background>
                            <ImageBrush ImageSource="Resources/Images/background.jpg"/>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="16*"></ColumnDefinition>
                            <ColumnDefinition Width="5*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0*"></RowDefinition>
                            <RowDefinition Height="64*"></RowDefinition>
                            <RowDefinition Height="167*"></RowDefinition>
                            <RowDefinition Height="172*"></RowDefinition>
                            <RowDefinition Height="125*"></RowDefinition>
                            <RowDefinition Height="69*"></RowDefinition>
                            <RowDefinition Height="69*"></RowDefinition>
                            <RowDefinition Height="49*"></RowDefinition>
                        </Grid.RowDefinitions>

                        <Viewbox Grid.Column="3" Grid.Row="1" VerticalAlignment="Top" Margin="0,15,0,0" Height="42">
                            <StackPanel>
                                <TextBlock x:Name="textRound" TextWrapping="Wrap" Text="ROUND" 
                                           
                                    Foreground="#FFEAAC06" FontSize="36" FontWeight="Bold"/>
                                <Rectangle HorizontalAlignment="Stretch" Fill="#FFEAAC06" Height="2" Margin="4,-7,3,0"/>
                                <Rectangle Width="130" Fill="#FFEAAC06" Height="2" Margin="0,1,0,0"/>
                                <Rectangle Width="70" Fill="#FFEAAC06" Height="2" Margin="0,3,0,0"/>
                            </StackPanel>
                            
                        </Viewbox>

                        <Viewbox x:Name="viewBoxItem1" Grid.Column="1" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,0" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img1" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize1" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"                                   
                            ></TextBlock>
                                <TextBlock x:Name="textRandom1"  Text="000" Foreground="#FFEAAC06" 
                                Width="150" TextAlignment="Center"
                                FontSize="30" FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem2" Grid.Column="2" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,0" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img2" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize2" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                                ></TextBlock>
                                <TextBlock x:Name="textRandom2" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30" FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem3"  Grid.Column="3" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,0" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img3" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize3" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center" ></TextBlock>
                                <TextBlock x:Name="textRandom3"  Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30" FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem4" Grid.Column="4" Grid.Row="2" VerticalAlignment="Top" Margin="0,0,0,0" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img4" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize4" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                               ></TextBlock>
                                <TextBlock x:Name="textRandom4"  Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30" FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem5" Grid.Column="5" Grid.Row="2" VerticalAlignment="Top" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img5" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize5" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                                 ></TextBlock>
                                <TextBlock x:Name="textRandom5" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30" FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem6" Grid.Column="1" Grid.Row="3" VerticalAlignment="Top" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img6" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize6" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                                ></TextBlock>
                                <TextBlock x:Name="textRandom6" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30"  FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem7" Grid.Column="2" Grid.Row="3" VerticalAlignment="Top" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img7" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize7" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                                ></TextBlock>
                                <TextBlock x:Name="textRandom7" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30" FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem8" Grid.Column="3" Grid.Row="3" VerticalAlignment="Top" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img8" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize8" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                                 ></TextBlock>
                                <TextBlock x:Name="textRandom8" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30"  FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem9" Grid.Column="4" Grid.Row="3" VerticalAlignment="Top" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img9" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize9" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                                ></TextBlock>
                                <TextBlock x:Name="textRandom9" Text="000" Foreground="#FFEAAC06" 
                               Width="100" TextAlignment="Center"
                               FontSize="30" FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="viewBoxItem10" Grid.Column="5" Grid.Row="3" VerticalAlignment="Top" Height="150">
                            <StackPanel>
                                <Border CornerRadius="5,5,5,5" Width="100" Height="100">
                                    <Border.Background>
                                        <ImageBrush  x:Name="img10" Stretch="None" />
                                    </Border.Background>
                                </Border>
                                <TextBlock x:Name="textPrize10" Text="Prize" Foreground="#FFD8D8D6" FontSize="20" 
                               Width="180" TextAlignment="Center"
                                ></TextBlock>
                                <TextBlock x:Name="textRandom10" Text="000" Foreground="#FFEAAC06" FontSize="30" 
                               Width="100" TextAlignment="Center"
                                 FontWeight="Bold"></TextBlock>
                                <Rectangle Width="40" Fill="#FFEAAC06" Height="2" Margin="0,-2,0,0"/>
                            </StackPanel>
                        </Viewbox>

                        <Viewbox Grid.Column="2" Grid.Row="4" Width="55" HorizontalAlignment="Right" Margin="0,0,15,0">
                            <Button Style="{StaticResource TransparentButton}" Click="PreviousButton_Click" >
                                <StackPanel Cursor="Hand">
                                    <TextBlock Foreground="#aa8dc5" TextAlignment="Right" Margin="10,0,-5,-10" FontWeight="Bold">PREVIOUS</TextBlock>
                                    <Image Width="60" Height="22" Source="Resources/Images/prev.png"></Image>
                                </StackPanel>
                            </Button>
                        </Viewbox>
                        <Viewbox Grid.Column="3" Grid.Row="4" >
                            <StackPanel>
                                <Button Width="144" Height="100" Style="{StaticResource TransparentButton}"
                        Click="RunButton_Click" BorderBrush="{x:Null}" Background="{x:Null}">
                                    <StackPanel Cursor="Hand">
                                        <Image Width="144" Height="100" Source="Resources/Images/run.png"></Image>
                                    </StackPanel>
                                </Button>
                                <Image Width="50" Height="80"  Source="Resources/Images/arrow.png" Margin="0,-50,0,0"
                           ></Image>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox Grid.Column="4" Grid.Row="4" Width="30" HorizontalAlignment="Left" Margin="15,0,0,0">
                            <Button Style="{StaticResource TransparentButton}" Click="NextButton_Click" >
                                <StackPanel Cursor="Hand">
                                    <TextBlock Foreground="#FFEAAC06" Margin="-5,0,0,-9" FontWeight="Bold">NEXT</TextBlock>
                                    <Image Width="32" Height="20" Source="Resources/Images/next.png"></Image>
                                </StackPanel>
                            </Button>
                        </Viewbox>

                        <Viewbox Grid.Row="5" Grid.Column="3" VerticalAlignment="Top" Height="57" Margin="11,-20,12,0">
                            <StackPanel>
                                <TextBlock Text="RANGE RANDOM" Foreground="#aa8dc5" 
                                           FontWeight="Bold"
                             FontSize="20"                                   
                               TextAlignment="Center"
                                   />
                                <TextBlock x:Name="textRandomRange" 
                               TextWrapping="Wrap" Text="100-200"                                 
                               TextDecorations="{x:Null}" 
                               TextAlignment="Center"
                               Foreground="#FFEAAC06" FontSize="33"
                               />
                            </StackPanel>
                        </Viewbox>

                        <Viewbox Grid.Column="2" Grid.Row="6" Grid.ColumnSpan="3" Margin="60,0,59,0">
                            <StackPanel>
                                <TextBlock FontSize="20">
                                    <Line X1="0" Y1="0" X2="200" Y2="0" Stroke="#aa8dc5" StrokeThickness="1"/>
                                    <TextBlock Text=" IGNORED " VerticalAlignment="Center" Foreground="#aa8dc5" 
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center" Margin="0,0,0,-35"/>
                                    <Line X1="0" Y1="0" X2="200" Y2="0" Stroke="#FFD8D8D6" StrokeThickness="1"/>
                                </TextBlock>                                
                                
                                <TextBlock x:Name="textIgnored" 
                                         Margin="0,10,0,0"
                                        TextWrapping="Wrap" Width="430"
                                        Text="100,200,100,200,100,200,100,200,100,200,100,200,100,200,100,200,"                                
                                        TextDecorations="{x:Null}" 
                                        Foreground="#FFD8D8D6" FontSize="16"/>   
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                </Viewbox>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabSetting" Header="Settings" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Settings" Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,0,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <TabControl Grid.ColumnSpan="2" Margin="33,50,30,30" >
                    <TabItem x:Name="tabPrize" Header="Prizes">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="prizeDataGrid" Margin="33.418,10,302,75" CanUserAddRows ="True" Grid.Column="1" 
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="PrizeIndex" Binding="{Binding PrizeIndex}"/>
                                    <DataGridTextColumn Header="PrizeName" Binding="{Binding PrizeName}" />
                                    <DataGridTextColumn Header="RoundIndex" Binding="{Binding RoundIndex}"/>
                                    <DataGridTextColumn Header="RoundName" Binding="{Binding RoundName}" />
                                    <DataGridTemplateColumn Header="Image" Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Image Source="{Binding PrizeImage}" Stretch="None" Width="100" Height="100" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn  Width="SizeToCells" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Upload Image" Width="85"
                                                    Click="UploadButton_Click"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SavePrizesButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRange" Header="Random Range">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="rangeDataGrid" Margin="33.418,10,302,75" Grid.Column="1"
                                      AutoGenerateColumns="False" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Random From" Binding="{Binding RandomFrom}"/>
                                    <DataGridTextColumn Header="Random To" Binding="{Binding RandomTo}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75" Grid.Column="1"
                                    Click="SaveRangeButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabIgnoredList" Header="Ignored List">
                        <Grid Background="#FFE5E5E5">
                            <DataGrid x:Name="ignoredListDataGrid" AutoGenerateColumns="False" Margin="33.418,10,302,75" CanUserAddRows ="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ignored List" Binding="{Binding Excluded}" Width="500"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Save" HorizontalAlignment="Left" Margin="33,0,0,28" VerticalAlignment="Bottom" Width="75"
                                Click="SaveIgnoredListButton_Click"/>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="tabRun" Header="Run" >
                        <Grid Margin="10,-2,74,-1">
                            <Button Content="Start New Game" Height="28" Width="100" Margin="70,125,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" 
                                    Click="NewGameButton_Click" />
                            <Label Content="Start Prize Index" HorizontalAlignment="Left" Margin="70,75,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.395,1.154"/>
                            <TextBox x:Name="textPrizeStartIndex" HorizontalAlignment="Left" Height="23" Margin="170,79,0,0" TextWrapping="Wrap" Text="1" VerticalAlignment="Top" Width="120" RenderTransformOrigin="0.554,0.913"/>
                            <TextBlock HorizontalAlignment="Left" Margin="315,70,0,0" TextWrapping="Wrap" Text="You should always keep this value 1 unless you really need to start at a specific prize index. All prizes less than this start index will be ignored." VerticalAlignment="Top" Height="39" Width="482" Foreground="#FFDA0707"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabResult" Header="Result" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Result" Canvas.Left="185" Canvas.Top="23"  FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="resultDataGrid" Margin="33.418,60,30,30" IsReadOnly="True" Grid.Column="1"
                            SelectionChanged="ResultDataGrid_SelectionChanged"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="tabLog" Header="Log" BorderBrush="{x:Null}" Visibility="Collapsed">
            <Grid>
                <Label Content="Log" Canvas.Left="185" Canvas.Top="23" FontSize="20" Margin="30,10,0,0" FontWeight="Bold" Foreground="#FF6C5B5B"/>
                <DataGrid x:Name="logDataGrid" Margin="33,60,30,30" IsReadOnly="True"
                          SelectionChanged="LogDataGrid_SelectionChanged"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>