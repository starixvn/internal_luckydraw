<?xml version="1.0"?>
<configuration>
    <configSections>
        <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net, Version=1.2.11.0, Culture=neutral, PublicKeyToken=669e0ddf0bb1aa2a" />
    </configSections>
    <log4net>
        <root>
            <level value="ALL" />
            <appender-ref ref="RollingFile" />
        </root>
        <logger name="UpLogger">
            <level value="DEBUG" />
        </logger>
        <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
            <file value="client_logs/log.txt" />
            <appendToFile value="true" />
            <maximumFileSize value="10000KB" />
            <maxSizeRollBackups value="2" />
            <layout type="log4net.Layout.PatternLayout">
                <conversionPattern value="%d [%t] %-5p %c --> %m%n" />
            </layout>
        </appender>
    </log4net>
    <appSettings>
        <add key="IP" value="10.19.10.65"/>
        <add key="Port" value="51511"/>
        <add key="KeypressTime" value="300"/>
        <add key="Grade" value="10,11,12"/>
        <add key="ExistOnSubmit" value="true"/>
    </appSettings>
