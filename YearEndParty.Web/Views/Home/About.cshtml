@{
    string title = "About";
    ViewBag.Title = title;
}
<div data-role="page">
    <div data-role="header" data-theme="d">
	    <h1>@title</h1>
    </div>
    <div data-role="content" data-theme="d">	
	    <p>
            <b>Staff Annual Party @Resource.__YearEnd</b>
            <br />
            <em>Version 1.0.2</em>
            <br />
            <em>&copy; @Resource.__YearEnd Nexcel Solutions. All rights reserved.</em>
        </p>
        <a href="@Url.Content("~/")" data-role="button" data-rel="back" data-theme="c">OK, I got it!</a>  	
    </div>
</div>