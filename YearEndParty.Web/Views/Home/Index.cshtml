@{
    string title = "Staff Annual Party 2014";
	ViewBag.Title = title;
}
<div data-role="page">
	<div data-role="header" data-theme="b">
		<a href="@Url.Action("About")" data-rel="dialog" data-transition="pop" data-icon="info"
			data-iconpos="notext">About</a>
		<h1>@title</h1>
		<a href="javascript:window.location.reload()" data-icon="refresh" class="ui-btn-right">Refresh</a>
	</div>

	<div data-role="content">
		<ul data-role="listview" data-inset="true">
			<li data-role="list-divider">Party Program</li>
			<li><a href="@Url.Action("PartyAgenda")" data-transition="slide">Party Agenda</a></li>
			<li><a href="@Url.Action("DinnerMenu")" data-transition="slide">Dinner Menu</a></li>

			<li data-role="list-divider">Lucky Draw</li>
			@foreach (var t in Model)
			{ 
				<li><a href="@Url.Action("Lucky", "LuckyDraw", new { id = t.PrizeType })"
					data-transition="slide">@t.Name</a><span class="ui-li-count">@t.Quantity</span></li>
			}
			<li data-theme="e">
				<a href="@Url.Action("Winner", "LuckyDraw")">Winners</a>
				<span class="ui-li-count">@ViewData["counter"]</span>
			</li>

		 	<!--<li data-role="list-divider">Awards</li>
			<li><a rel="external" href="@Url.Action("LongService", "Award")" data-transition="slide">Long Service Award</a></li>
			<li><a rel="external" href="@Url.Action("YearEmployee", "Award")" data-transition="slide">Employee of The Year</a></li>
            -->
		</ul>
	</div>

	<div data-role="footer" data-theme="b">
		<h4>&copy; Staff Annual Party 2014</h4>
	</div>
</div>