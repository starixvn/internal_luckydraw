@{
	string title = "Lucky Draw";
	ViewBag.Title = title;
	Layout = "~/Views/Shared/_Layout.cshtml";
}
<div data-role="page">
	<div data-role="header" data-theme="b">
		<a href="/" data-transition="slide" data-icon="back">Back</a>
		<h1>@title</h1>
	</div>
	<div data-role="content">
		<ul data-role="listview" data-inset="true" data-theme="d">
			@foreach (var t in Model)
			{ 
				<li><a href="@Url.Action("lucky/@t.PrizeType")" data-transition="slide">@t.Name</a><span
					class="ui-li-count">@t.Quantity</span></li>
			}
			<li data-role="list-divider" role="heading" data-theme="e"><a href="@Url.Action("winner")">
				Winners</a><span class="ui-li-count">@ViewData["counter"]</span></li>
		</ul>
	</div>
	<div data-role="footer" data-theme="b">
		<h4>&copy; Staff Annual Party @Resource.__YearEnd</h4>
	</div>
</div>