@{
	string title = "Lucky Draw";
	ViewBag.Title = title;
	var prizeList = Model as List<YearEndParty.Web.Models.PrizeTypeModel>;
}
<div data-role="page">
	<div data-role="header" data-theme="b">
		<a data-rel="back" data-icon="back">Back</a>
		<h1>@title</h1>
        <a href="javascript:window.location.reload()" data-icon="refresh" class="ui-btn-right">Refresh</a>
	</div>
	<div data-role="content" role="main">
		@{
			int index = 0;

			foreach (var type in prizeList)
			{   
			<ul data-role="listview" data-inset="true">
				<li data-role="list-divider">@type.Name</li>
				@foreach (var prize in type.Prizes)
				{                    
					<li data-theme="c">
						<img src="@Url.Action("Handler", "Image", new { type = "prize", id = prize.PrizeId })" alt="" />
						<h3>@prize.PrizeName</h3>
						<span class="ui-li-count">@(++index)</span>
					</li>
					foreach (var wi in prize.Winners)
					{
					<li data-theme="d">
						@wi.FullName - @wi.Department
					</li>
					}
				}
			</ul>
			}
		}
	</div>
	<div data-role="footer" data-theme="b">
		<h4>&copy; Staff Annual Party @Resource.__YearEnd</h4>
	</div>
</div>