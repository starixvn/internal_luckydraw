@{
    ViewBag.Title = ViewData["awardName"];
}
<div data-role="page">
    <div data-role="header" data-theme="b">
        <a data-rel="back" data-icon="back">Back</a>
        <h1>
            @ViewData["awardName"]
        </h1>
        <a href="javascript:window.location.reload()" data-icon="refresh" class="ui-btn-right">Refresh</a>
    </div>
    <div data-role="content" role="main">
            @foreach (YearEndParty.Web.Models.AwardModel win in (List<YearEndParty.Web.Models.AwardModel>)Model)
            {
                <ul data-role="listview" data-inset="true">
                    @if (win.Winners.ToList().Count > 0)
                    { 
                        <li data-role="list-divider">@win.Name</li>
                        foreach (var emp in win.Winners)
                        {
                            <li>
                                <img src="/image/handler/staff/@emp.StaffId" />
                                <h3>@emp.FullName</h3>
                                <p>@emp.Department</p>
                            </li>
                        }
                    }
                </ul>
            }
    </div>
    <div data-role="footer" data-theme="b">
        <h4>
            &copy; 2011 by Nexcel
        </h4>
    </div>
</div>
